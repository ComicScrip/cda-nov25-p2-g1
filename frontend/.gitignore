/.next/
/.next_premerge_backup_*
/out/

# production
/build

# variables d'environnement (ne pas commiter les secrets)
.env
.env.local
.env.*.local
!.env.example

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
