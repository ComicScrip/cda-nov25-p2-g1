.pnpm-debug.log*

# cache & outils
.cache/
.turbo/
.eslintcache
.biome-cache/

# vercel
.vercel

# typescript & build
*.tsbuildinfo
next-env.d.ts

# SWC (Next.js)
.swc

# IDE / éditeur
.idea/
*.swp
