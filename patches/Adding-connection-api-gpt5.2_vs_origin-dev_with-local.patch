diff --git a/.github/workflows/test-backend.yml b/.github/workflows/test-backend.yml
new file mode 100644
index 0000000000000000000000000000000000000000..0ea1259a8d2f3fe88f2a54c42b9cf36d858178cd
--- /dev/null
+++ b/.github/workflows/test-backend.yml
@@ -0,0 +1,32 @@
+name: Test backend
+
+on:
+  pull_request:
+    paths: [ 'backend/**' ]
+  workflow_call:
+
+jobs:
+  testing-backend:
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: ./backend
+    env:
+      NODE_ENV: test
+
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+      - name: Create env file for tests
+        run: cp .env.example .env
+      - name: Install dependencies
+        run: npm ci
+      - name: Start test DB
+        run: npm run testDB
+      - name: Run backend tests
+        run: npm run test
+      - name: Stop test DB
+        if: always()
+        run: docker compose -f docker-compose.integration-tests.yml down --remove-orphans
